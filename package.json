    "audit:exam": "tsx scripts/audit-exam.ts",
    "audit:content": "tsx scripts/audit-content.ts",
    "audit": "npm run audit:exam && npm run audit:content && npm run test",
    "ci": "npm run audit && npm run build"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
